# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never put a real key in this file, in code, or in a fixture.

DAGENT_LOG_LEVEL=info

# Where durable run state lives. Needed by `--store postgres`, and required for
# distributed runs: a worker is a different process, so `memory` cannot reach it.
# DAGENT_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/dagent

# The Phase 8 work channel. Needed by `--queue redis` and by `dagent worker`.
# DAGENT_REDIS_URL=redis://localhost:6379/0

# Model provider credentials. Nothing reads these until Phase 3, and only modules
# under dagent/agents/ ever will — the core packages never see a provider key.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
