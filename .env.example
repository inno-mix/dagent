# Copy to .env and fill in:  cp .env.example .env
# .env is gitignored. Never put a real key in this file, in code, or in a fixture.

DAGENT_LOG_LEVEL=info

# Model provider credentials. Nothing reads these until Phase 3, and only modules
# under dagent/agents/ ever will — the core packages never see a provider key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
